{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed canonical Project v1 (no live storage migration)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_version",
    "project_id",
    "name",
    "canonical_path",
    "role",
    "status",
    "revision",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "migration_version": {
      "const": 0,
      "type": "integer"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "active",
        "client",
        "personal",
        "reference",
        "archive",
        "template",
        "generated",
        "experimental",
        "unknown"
      ]
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 5
    },
    "project_type": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package_managers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_sites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_url": {
      "type": "string",
      "format": "uri",
      "description": "HTTP(S), without credentials, query or fragment; runtime validator enforces this."
    },
    "production_url": {
      "type": "string",
      "format": "uri",
      "description": "HTTP(S), without credentials, query or fragment; runtime validator enforces this."
    },
    "staging_url": {
      "type": "string",
      "format": "uri",
      "description": "HTTP(S), without credentials, query or fragment; runtime validator enforces this."
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "description": "Argv declarations only. Preview never executes them."
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy": {
          "enum": [
            "public",
            "project-public",
            "private-project"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Patterns must stay relative. Mandatory policy exclusions cannot be weakened."
    },
    "canonical_path": {
      "type": "string",
      "description": "Absolute canonical path, platform-aware and link-safe."
    },
    "status": {
      "enum": [
        "proposed",
        "confirmed",
        "paused",
        "archived"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "git": {
      "type": "object",
      "description": "Read-only redacted Git observation including branch, commit and nullable dirty state."
    },
    "wamp_mapping": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC timestamp with evidence; unknown stays null."
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC timestamp with evidence; unknown stays null."
    },
    "last_activity": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC timestamp with evidence; unknown stays null."
    },
    "last_audit": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC timestamp with evidence; unknown stays null."
    },
    "last_knowledge_index": {
      "type": [
        "string",
        "null"
      ],
      "description": "UTC timestamp with evidence; unknown stays null."
    }
  }
}
