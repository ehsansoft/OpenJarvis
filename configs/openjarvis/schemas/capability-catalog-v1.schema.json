{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenJarvis workstation capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "read_only",
    "acceptance_evidence",
    "probe_failures",
    "capabilities",
    "context_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_only": {
      "const": true
    },
    "acceptance_evidence": {
      "type": "object"
    },
    "probe_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe",
          "failure_type",
          "service",
          "http_status"
        ],
        "properties": {
          "probe": {
            "type": "string"
          },
          "failure_type": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "status",
          "configured",
          "installed",
          "accepted",
          "reason",
          "evidence",
          "observed_at",
          "next_action",
          "related_commands",
          "privacy",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "READY",
              "MANUAL_SETUP",
              "DISABLED",
              "BLOCKED",
              "NOT_INSTALLED",
              "NOT_APPLICABLE"
            ]
          },
          "configured": {
            "type": "boolean"
          },
          "installed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "related_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacy": {
            "enum": [
              "local-private",
              "public-metadata",
              "external-session"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "READY"
                }
              }
            },
            "then": {
              "properties": {
                "configured": {
                  "const": true
                },
                "installed": {
                  "const": true
                },
                "accepted": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
